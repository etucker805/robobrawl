<?xml version="1.0" encoding="UTF-8"?>
<!-- TMS_VERSION 2.0.2 -->
<qos_library name="TMS"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://www.omg.org/spec/DDS-XML"
	xsi:schemaLocation="http://www.omg.org/spec/DDS-XML schema/dds-xml_qos_definitions.xsd">
	
	<!-- Base Profile -->
	<qos_profile name="tms_base">
		<datareader_qos>
			<ownership>
				<kind>EXCLUSIVE_OWNERSHIP_QOS</kind>
			</ownership>
			<representation>
				<value>0x0002</value>
			</representation>
		</datareader_qos>
		<datawriter_qos>
			<ownership>
				<kind>EXCLUSIVE_OWNERSHIP_QOS</kind>
			</ownership>
			<ownership_strength>
				<value>1</value> <!-- Note:  This value must increase each time the device restarts.  -->
			</ownership_strength>
			<representation>
				<value>0x0002</value>
			</representation>
		</datawriter_qos>
	</qos_profile>
	
	<!-- Base Profile for periodic profiles -->
	<qos_profile name="tms_base_periodic" base_name="tms_base">
		<datareader_qos>
			<durability>
				<kind>VOLATILE_DURABILITY_QOS</kind>
			</durability>
			<history>
				<kind>KEEP_LAST_HISTORY_QOS</kind>
				<depth>1</depth>
			</history>
			<liveliness>
				<kind>AUTOMATIC_LIVELINESS_QOS</kind>
				<lease_duration>
					<sec>DURATION_INFINITE_SEC</sec>
					<nanosec>DURATION_INFINITE_NSEC</nanosec>
				</lease_duration>
			</liveliness>
			<reliability>
				<kind>BEST_EFFORT_RELIABILITY_QOS</kind>
			</reliability>
			<representation>
				<value>0x0002</value>
			</representation>
		</datareader_qos>
		<datawriter_qos>
			<durability>
				<kind>VOLATILE_DURABILITY_QOS</kind>
			</durability>
			<history>
				<kind>KEEP_LAST_HISTORY_QOS</kind>
				<depth>1</depth>
			</history>
			<liveliness>
				<kind>AUTOMATIC_LIVELINESS_QOS</kind>
				<lease_duration>
					<sec>DURATION_INFINITE_SEC</sec>
					<nanosec>DURATION_INFINITE_NSEC</nanosec>
				</lease_duration>
			</liveliness>
			<reliability>
				<kind>BEST_EFFORT_RELIABILITY_QOS</kind>
			</reliability>
			<representation>
				<value>0x0002</value>
			</representation>
		</datawriter_qos>
	</qos_profile>

	<qos_profile name="PublishLast" base_name="tms_base">
		<datareader_qos>
			<deadline>
				<period>
					<sec>DURATION_INFINITE_SEC</sec>
					<nanosec>DURATION_INFINITE_NSEC</nanosec>
				</period>
			</deadline>
			<durability>
				<kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
			</durability>
			<history>
				<kind>KEEP_LAST_HISTORY_QOS</kind>
				<depth>1</depth>
			</history>
			<liveliness>
				<kind>AUTOMATIC_LIVELINESS_QOS</kind>
				<lease_duration>
					<sec>DURATION_INFINITE_SEC</sec>
					<nanosec>DURATION_INFINITE_NSEC</nanosec>
				</lease_duration>
			</liveliness>
			<reliability>
				<kind>RELIABLE_RELIABILITY_QOS</kind>
			</reliability>
			<representation>
				<value>0x0002</value>
			</representation>
		</datareader_qos>
		<datawriter_qos>
			<deadline>
				<period>
					<sec>DURATION_INFINITE_SEC</sec>
					<nanosec>DURATION_INFINITE_NSEC</nanosec>
				</period>
			</deadline>
			<durability>
				<kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
			</durability>
			<history>
				<kind>KEEP_LAST_HISTORY_QOS</kind>
				<depth>1</depth>
			</history>
			<liveliness>
				<kind>AUTOMATIC_LIVELINESS_QOS</kind>
				<lease_duration>
					<sec>DURATION_INFINITE_SEC</sec>
					<nanosec>DURATION_INFINITE_NSEC</nanosec>
				</lease_duration>
			</liveliness>
			<reliability>
				<kind>RELIABLE_RELIABILITY_QOS</kind>
			</reliability>
			<representation>
				<value>0x0002</value>
			</representation>
		</datawriter_qos>
	</qos_profile>
	
	<qos_profile name="Rare" base_name="tms_base_periodic">
		<datareader_qos>
			<deadline>
				<period>
					<sec>2000</sec>
					<nanosec>0</nanosec>
				</period>
			</deadline>
			<representation>
				<value>0x0002</value>
			</representation>
		</datareader_qos>
		<datawriter_qos>
			<deadline>
				<period>
					<sec>2000</sec>
					<nanosec>0</nanosec>
				</period>
			</deadline>
			<representation>
